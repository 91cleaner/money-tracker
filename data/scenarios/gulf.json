{"id":"gulf","title":"걸프전쟁","period":"1990–1991","view":[[22,38],[36,52]],"sides":{"a":["다국적군","#4db8ff"],"b":["이라크","#ff5a5a"]},"sources":["위키백과 '걸프 전쟁' 문서","Wikipedia 'Gulf War'","Wikipedia 'Iraqi invasion of Kuwait'","유엔 안전보장이사회 결의 660·678호 (un.org)","미 국방부 걸프전쟁 최종 보고서 (1992)"],"frames":[{"d":"1990-08-02","t":"이라크군이 쿠웨이트를 침공했어요","cc":{"IQ":"b","KW":"b"},"ar":[[30.5,47.6,29.4,47.9,"b"]],"bt":[[29.37,47.98,"쿠웨이트시"]],"more":"같은 날 유엔 안보리가 결의 660호로 철수를 요구했어요."},{"d":"1990-08-07","t":"미군이 사우디아라비아에 배치되기 시작했어요 (사막의 방패)","cc":{"SA":"a","KW":"b"},"ar":[[30.0,32.0,26.3,50.1,"a"]]},{"d":"1990-08-28","t":"이라크가 쿠웨이트를 자기 땅이라고 선언했어요","more":"국제사회는 인정하지 않았어요."},{"d":"1990-11-29","t":"유엔이 1991년 1월 15일까지 철수하라고 했어요","more":"결의 678호는 시한까지 철수하지 않으면 모든 필요한 수단을 쓸 수 있다고 했어요."},{"d":"1991-01-17","t":"다국적군 공습이 시작됐어요 (사막의 폭풍)","bt":[[33.31,44.36,"바그다드 공습"]],"ar":[[26.3,50.1,33.2,44.4,"a"],[24.0,40.0,32.5,43.0,"a"]]},{"d":"1991-01-18","t":"이라크가 이스라엘과 사우디로 스커드 미사일을 쐈어요","bt":[[32.08,34.78,"텔아비브"],[24.71,46.68,"리야드"]],"ar":[[32.5,42.0,32.1,35.0,"b"],[31.0,46.0,24.9,46.7,"b"]]},{"d":"1991-01-29","t":"사우디 카프지에서 지상 전투가 있었어요","bt":[[28.42,48.49,"카프지 전투"]],"ar":[[28.7,48.3,28.45,48.5,"b"]]},{"d":"1991-02-24","t":"지상전이 시작됐어요","ar":[[28.5,47.8,29.3,47.9,"a"],[28.6,46.5,29.4,47.4,"a"],[29.0,44.5,30.8,46.2,"a"],[29.3,43.0,31.0,45.5,"a"]],"front":[[[28.55,46.55],[29.1,47.6],[28.55,48.4]]],"more":"서쪽으로 크게 돌아 이라크 안쪽을 막는 작전도 함께 했어요."},{"d":"1991-02-26","t":"이라크군이 쿠웨이트에서 물러나며 유정에 불을 질렀어요","bt":[[29.6,47.7,"80번 고속도로"],[29.2,47.5,"유정 화재"]],"ar":[[29.4,47.9,30.4,47.7,"b"]],"more":"약 700개의 유정이 불탔어요."},{"d":"1991-02-27","t":"쿠웨이트시가 해방됐어요","cc":{"KW":"a"},"bt":[[29.37,47.98,"쿠웨이트 해방"]]},{"d":"1991-02-28","t":"다국적군이 공격을 멈췄어요","more":"지상전 시작 약 100시간 만이었어요."},{"d":"1991-03-03","t":"사프완에서 휴전 회담을 했어요","bt":[[30.11,47.72,"사프완 회담"]],"more":"4월 결의 687호로 공식 휴전이 이뤄졌어요."}]}