{"id":"korea","title":"한국전쟁","period":"1950–1953","view":[[33,123],[42.5,131]],"sides":{"a":["대한민국·유엔군","#4db8ff"],"b":["북한·중국","#ff5a5a"]},"sources":["위키백과 '한국 전쟁' 문서","Wikipedia 'Korean War'","국방부 군사편찬연구소 '6·25전쟁사'","미 육군 군사사 센터 (U.S. Army Center of Military History) 한국전쟁 연표"],"frames":[{"d":"1950-06-25","t":"북한군이 38선을 넘어 남쪽으로 공격했어요","front":[[[37.75,126.1],[37.95,126.7],[38.1,127.2],[38.2,127.8],[38.3,128.3],[38.6,128.6]]],"ar":[[38.2,126.6,37.6,127.0,"b"],[38.2,127.4,37.6,127.5,"b"],[38.3,128.5,37.8,128.9,"b"]],"more":"새벽 4시쯤 38선 전체에서 공격이 시작됐어요. 유엔 안전보장이사회는 같은 날 북한군 철수를 요구하는 결의를 냈어요."},{"d":"1950-06-28","t":"서울이 북한군에 점령됐어요","front":[[[37.6,126.6],[37.5,127.2],[37.4,128.0],[37.5,129.0]]],"bt":[[37.57,126.98,"서울 점령"]],"ar":[[37.5,127.0,36.8,127.1,"b"]]},{"d":"1950-07-05","t":"오산에서 미군과 북한군의 첫 전투가 있었어요","front":[[[37.1,126.7],[37.15,127.2],[37.2,128.2],[37.3,129.2]]],"bt":[[37.15,127.07,"오산 전투"]]},{"d":"1950-07-20","t":"대전이 북한군에 점령됐어요","front":[[[36.0,126.6],[36.3,127.3],[36.6,128.3],[36.6,129.4]]],"bt":[[36.35,127.38,"대전 전투"]],"ar":[[36.3,127.3,35.6,127.9,"b"]]},{"d":"1950-08-04","t":"낙동강 방어선이 만들어졌어요","front":[[[35.0,128.0],[35.5,128.35],[35.9,128.45],[36.1,128.6],[36.05,129.4]]],"bt":[[36.05,128.5,"다부동 전투"]],"more":"8월부터 9월 중순까지 낙동강과 동쪽 산줄기를 따라 방어선을 지켰어요."},{"d":"1950-09-15","t":"유엔군이 인천에 상륙했어요","front":[[[35.0,128.0],[35.5,128.35],[35.9,128.45],[36.1,128.6],[36.05,129.4]]],"bt":[[37.47,126.6,"인천상륙작전"]],"ar":[[36.6,125.4,37.45,126.55,"a"],[35.6,128.4,36.3,128.0,"a"]]},{"d":"1950-09-28","t":"서울을 다시 찾았어요","front":[[[37.75,126.1],[37.95,126.7],[38.1,127.2],[38.2,127.8],[38.3,128.3],[38.6,128.6]]],"bt":[[37.57,126.98,"서울 수복"]],"ar":[[36.5,127.5,37.6,127.6,"a"]]},{"d":"1950-10-01","t":"국군이 38선을 넘어 북쪽으로 갔어요","front":[[[38.4,126.4],[38.6,127.3],[38.9,127.8],[39.0,128.0]]],"ar":[[38.3,128.5,39.1,127.5,"a"]],"more":"10월 1일은 지금 국군의 날이에요."},{"d":"1950-10-19","t":"유엔군이 평양을 점령했어요","front":[[[39.6,124.6],[39.7,125.6],[39.9,126.5],[40.0,127.4],[40.4,128.6]]],"bt":[[39.03,125.75,"평양 점령"]],"ar":[[38.6,126.5,39.0,125.8,"a"],[40.7,124.5,40.3,125.3,"b"]],"more":"같은 날쯤부터 중국군이 압록강을 건너 들어오기 시작했어요."},{"d":"1950-10-26","t":"국군 일부가 압록강 초산에 닿았어요","front":[[[40.6,124.6],[40.8,125.8],[40.9,126.8],[40.7,127.6],[41.0,128.8]]],"bt":[[40.83,125.8,"초산"]],"ar":[[41.0,126.2,40.4,126.0,"b"]],"more":"중국군의 1차 공세가 10월 25일쯤 시작됐어요."},{"d":"1950-11-27","t":"장진호 전투가 시작됐어요","front":[[[39.6,124.6],[39.7,125.6],[39.9,126.5],[40.0,127.4],[40.4,128.6]]],"bt":[[40.4,127.25,"장진호 전투"],[39.6,125.9,"청천강 전투"]],"ar":[[40.9,126.0,39.8,125.9,"b"],[40.9,127.3,40.4,127.3,"b"]]},{"d":"1950-12-24","t":"흥남에서 군인과 피란민이 배로 철수했어요","front":[[[37.75,126.1],[37.95,126.7],[38.1,127.2],[38.2,127.8],[38.3,128.3],[38.6,128.6]]],"bt":[[39.83,127.62,"흥남 철수"]],"ar":[[39.8,127.7,37.5,129.2,"a"]],"more":"흥남에서 약 9만 1천 명의 피란민이 배를 타고 남쪽으로 내려왔어요(동북부 전체 약 10만 명). 출처: 국방부 군사편찬연구소."},{"d":"1951-01-04","t":"서울을 다시 빼앗겼어요 (1·4 후퇴)","front":[[[37.1,126.8],[37.2,127.5],[37.35,128.3],[37.6,129.1]]],"bt":[[37.57,126.98,"1·4 후퇴"]],"ar":[[37.9,127.0,37.2,127.2,"b"]]},{"d":"1951-03-15","t":"서울을 두 번째로 다시 찾았어요","front":[[[37.6,126.4],[37.7,127.3],[37.8,128.2],[38.1,128.7]]],"ar":[[37.2,127.1,37.6,127.0,"a"]]},{"d":"1951-07-10","t":"개성에서 정전 회담이 시작됐어요","front":[[[37.75,126.1],[37.95,126.7],[38.25,127.1],[38.3,127.6],[38.3,128.0],[38.6,128.4],[38.62,128.36]]],"bt":[[37.97,126.55,"개성 회담"]],"more":"회담은 1951년 10월 판문점으로 옮겼고, 2년 가까이 이어지는 동안 전선 근처 고지 전투가 계속됐어요."},{"d":"1952-10-06","t":"철원 백마고지 전투가 있었어요","front":[[[37.75,126.1],[37.95,126.7],[38.25,127.1],[38.3,127.6],[38.3,128.0],[38.6,128.4],[38.62,128.36]]],"bt":[[38.25,127.22,"백마고지 전투"]]},{"d":"1953-07-27","t":"판문점에서 정전협정을 맺었어요","front":[[[37.75,126.1],[37.95,126.7],[38.25,127.1],[38.3,127.6],[38.3,128.0],[38.6,128.4],[38.62,128.36]]],"bt":[[37.956,126.677,"정전협정"]],"more":"전쟁은 끝나지 않고 멈춘 상태예요. 이때의 선을 기준으로 군사분계선과 비무장지대가 생겼어요."}]}