{"id":"vietnam","title":"베트남전쟁","period":"1955–1975","view":[[8,100],[23.5,112]],"sides":{"a":["남베트남·미국 등","#4db8ff"],"b":["북베트남·베트콩","#ff5a5a"]},"note":"17도선은 남북을 나눈 경계예요","sources":["위키백과 '베트남 전쟁' 문서","Wikipedia 'Vietnam War'","Wikipedia 'Tet Offensive'","Wikipedia 'Fall of Saigon'","미 국립문서보관소 (National Archives) 베트남전쟁 자료","국방부 군사편찬연구소 베트남전쟁 자료"],"frames":[{"d":"1964-08-02","t":"통킹만에서 미국 구축함과 북베트남 어뢰정이 충돌했어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[19.7,106.8,"통킹만 사건"]],"more":"8월 7일 미 의회가 통킹만 결의를 통과시켜 전쟁이 커졌어요. 8월 4일 두 번째 공격 보고는 나중에 사실이 아닌 것으로 밝혀졌어요."},{"d":"1965-03-08","t":"미 해병대가 다낭에 상륙했어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[16.07,108.22,"다낭 상륙"]],"ar":[[16.0,111.0,16.07,108.3,"a"]],"more":"3월 2일부터 북베트남 폭격(롤링 썬더 작전)이 시작됐어요."},{"d":"1965-10-09","t":"한국군 해병 청룡부대가 깜란에 상륙했어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[11.92,109.16,"청룡부대 깜란 상륙"]],"ar":[[13.0,112.0,11.95,109.2,"a"]],"more":"한국은 1973년까지 약 32만 명을 보냈어요. 출처: 국방부 군사편찬연구소."},{"d":"1965-10-22","t":"한국군 맹호부대가 퀴년에 상륙했어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[13.77,109.22,"맹호부대 퀴년 상륙"]],"ar":[[15.0,112.0,13.8,109.3,"a"]],"more":"출처: 국방부 군사편찬연구소."},{"d":"1965-11-14","t":"이아드랑 계곡 전투가 있었어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[13.6,107.7,"이아드랑 전투"]]},{"d":"1968-01-21","t":"케산 기지가 포위됐어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[16.65,106.73,"케산 전투"]],"ar":[[17.2,106.4,16.7,106.7,"b"]]},{"d":"1968-01-30","t":"북베트남과 베트콩이 구정 공세를 시작했어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[10.78,106.7,"사이공"],[16.46,107.59,"후에 전투"],[12.24,109.19,"나짱"]],"ar":[[17.3,106.8,16.5,107.5,"b"],[11.3,106.2,10.8,106.6,"b"]],"more":"남베트남 100곳이 넘는 도시와 마을이 동시에 공격받았어요. 군사적으로는 막아냈지만 미국 여론이 크게 바뀌었어요."},{"d":"1968-03-16","t":"미라이 마을에서 미군이 민간인을 학살했어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[15.18,108.87,"미라이 학살"]],"more":"수백 명의 비무장 주민이 숨졌어요. 1969년 언론 보도로 알려졌어요."},{"d":"1969-07-07","t":"미군 철수가 시작됐어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"ar":[[10.8,106.8,13.0,112.0,"a"]],"more":"닉슨 대통령은 남베트남군이 전쟁을 맡게 하는 정책을 폈어요."},{"d":"1970-04-30","t":"미군과 남베트남군이 캄보디아로 들어갔어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"ar":[[11.3,106.5,11.8,105.8,"a"]],"bt":[[11.6,106.0,"캄보디아 진입"]]},{"d":"1971-02-08","t":"남베트남군이 라오스로 들어갔어요 (람손 719)","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"ar":[[16.6,106.8,16.6,106.0,"a"]],"bt":[[16.6,106.0,"람손 719"]]},{"d":"1972-03-30","t":"북베트남이 부활절 공세를 시작했어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[16.75,107.18,"꽝찌 전투"],[11.65,106.6,"안록 전투"]],"ar":[[17.2,106.9,16.8,107.1,"b"],[14.4,107.6,14.35,108.0,"b"]]},{"d":"1972-12-18","t":"미군이 하노이와 하이퐁을 크게 폭격했어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[21.03,105.85,"라인배커 II 작전"],[20.86,106.68,"하이퐁"]],"ar":[[15.0,104.5,20.9,105.7,"a"]]},{"d":"1973-01-27","t":"파리 평화협정을 맺었어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"more":"3월 29일 마지막 미군 전투부대가 떠났어요. 남북 베트남의 싸움은 계속됐어요."},{"d":"1975-03-10","t":"북베트남군이 반메투옷을 공격했어요","front":[[[17.0,105.7],[17.0,106.6],[17.0,107.15]]],"bt":[[12.67,108.04,"반메투옷 전투"]],"ar":[[13.5,107.6,12.8,108.0,"b"]]},{"d":"1975-03-26","t":"후에가 북베트남군에 점령됐어요","bt":[[16.46,107.59,"후에 함락"]],"ar":[[16.9,107.2,16.5,107.55,"b"]]},{"d":"1975-03-29","t":"다낭이 북베트남군에 점령됐어요","front":[[[12.4,107.5],[12.5,108.5],[12.4,109.3]]],"bt":[[16.07,108.22,"다낭 함락"]],"ar":[[16.4,107.7,16.1,108.1,"b"],[12.7,108.1,12.3,109.1,"b"]],"more":"3월 29~30일 북베트남군이 다낭에 들어갔어요."},{"d":"1975-04-30","t":"사이공이 함락되며 전쟁이 끝났어요","bt":[[10.78,106.7,"사이공 함락"]],"ar":[[11.6,107.2,10.85,106.75,"b"]],"more":"1976년 베트남은 하나의 나라로 통일됐어요."}]}